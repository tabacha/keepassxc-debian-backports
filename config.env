# Zentrale Konfiguration. Wird von den Skripten per "source" gelesen:
# nur einfache Zuweisungen, keine Kommandos.
# Änderungen hier verlangen (bei gleicher VERSION) ein Hochzählen von REVISION.

# Maintainer-Eintrag im debian/changelog der Backports
MAINTAINER_NAME="KeePassXC Backports CI"
MAINTAINER_EMAIL="keepassxc-backports@sven.anders.hamburg"

# Versionssuffix: <debian-version>~${VERSION_TAG}+<revision>
# Bewusst NICHT "bpo13", damit es nie mit offiziellen Debian-Backports kollidiert.
VERSION_TAG="kpxc13"

# Suite-Namen im APT-Repo
DIST_STABLE="trixie-keepassxc"
DIST_SNAPSHOT="trixie-keepassxc-snapshot"

# Fingerprints der PRIMÄRschlüssel der Repo-Signing-Keys (40 Hex-Zeichen, ohne Leerzeichen).
# Öffentliche Schlüssel liegen in keys/repo-stable.asc bzw. keys/repo-snapshot.asc.
SIGNING_FPR_STABLE="7CA6E5DA5E7348D3F7265DE4DEE28CB25BEB71F6"
SIGNING_FPR_SNAPSHOT="C38C6A1C2B869B9E0CF16BE4926F7F2BE1378FAE"

# Release-Key von KeePassXC ("KeePassXC Release <release@keepassxc.org>").
# Wird gegen debian/upstream/signing-key.asc geprüft, wenn direkt von Upstream gebaut wird.
UPSTREAM_KEY_FPR="BF5A669F2272CF4324C1FDA8CFB4C2166397D0D2"

ARCHES="amd64 arm64"

# Wie viele Paketversionen pro Suite im Pool behalten werden
KEEP_VERSIONS_STABLE=3
KEEP_VERSIONS_SNAPSHOT=5

REPO_ORIGIN="KeePassXC Backports"

# Leer = https://<owner>.github.io/<repo>
PAGES_URL=""

# Build-Image. Gleicher Wert muss in .github/workflows/*.yml stehen
# (wird in PRs von scripts/check-pins.sh geprüft).
DEBIAN_IMAGE="debian:trixie@sha256:9c6e381421d0f48d1b8133e573f33c185ee16cbf505eda9c4a8a4791b25ea8a6"
