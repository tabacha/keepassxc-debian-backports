Description: Qt-SVG-Plugin als Abhängigkeit (Build und Laufzeit)
 Seit 2.8.0 liefert KeePassXC seine Icons als SVG aus. Qt lädt SVGs nur mit
 qt6-svg-plugins (imageformats/libqsvg.so, iconengines/libqsvgicon.so), das
 bisher nur über ein Recommends von libqt6gui6 ins System kommt.
 .
 Ohne Recommends (Build-Umgebungen, apt --no-install-recommends) sind die
 Datenbank-Icons leer; testguipixmaps schlägt deshalb auch auf den Debian-
 buildds fehl (verdeckt durch "|| true" in debian/rules).
Author: keepassxc-debian-backports
Forwarded: no
Last-Update: 2026-11-13
---
--- a/debian/control
+++ b/debian/control
@@ -25,6 +25,7 @@
                qt6-base-dev,
                qt6-l10n-tools,
                qt6-svg-dev,
+               qt6-svg-plugins <!nocheck>,
                qt6-tools-dev,
                qt6-tools-dev-tools,
                xauth <!nocheck>,
@@ -56,7 +57,7 @@
 
 Package: keepassxc-minimal
 Architecture: any
-Depends: ${misc:Depends}, ${shlibs:Depends}
+Depends: ${misc:Depends}, ${shlibs:Depends}, qt6-svg-plugins
 Breaks: keepassxc (<< 2.7.7+dfsg.1-3~)
 Conflicts: keepassxc-full
 Replaces: keepassxc
@@ -80,7 +81,7 @@
 
 Package: keepassxc-full
 Architecture: any
-Depends: ${misc:Depends}, ${shlibs:Depends}
+Depends: ${misc:Depends}, ${shlibs:Depends}, qt6-svg-plugins
 Breaks: keepassxc (<< 2.7.7+dfsg.1-3~)
 Conflicts: keepassxc-minimal
 Replaces: keepassxc
